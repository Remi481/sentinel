# First run: let the generator fill the secrets instead of editing this file.
#   Linux/macOS:  ./scripts/generate-secrets.sh --write
#   Windows:      powershell -ExecutionPolicy Bypass -File .\scripts\generate-secrets.ps1 -Write
# You can also copy this file to .env and replace every REPLACE_WITH_GENERATED_VALUE
# yourself; that text is an invalid placeholder the API refuses to start with.

# The DNS name this server answers on. Caddy gets a TLS certificate for it
# automatically. Use http://localhost to try the stack locally without TLS.
SENTINEL_DOMAIN=sentinel.example.com

# Database password for the bundled PostgreSQL container, at least 16 characters.
# PostgreSQL only reads it when the database volume is first created.
SENTINEL_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# Dashboard JWT signing key. At least 32 bytes.
SENTINEL_JWT_SECRET=REPLACE_WITH_GENERATED_VALUE

# Shared key a new agent presents once to enrol. At least 24 characters.
SENTINEL_ENROLLMENT_KEY=REPLACE_WITH_GENERATED_VALUE

# Bootstrap admin username, created on first start against an empty database.
SENTINEL_ADMIN_USERNAME=admin

# Bootstrap admin password, at least 12 characters.
SENTINEL_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# Seconds between an agent's metrics and heartbeat samples.
SENTINEL_INTERVAL_SECONDS=30
