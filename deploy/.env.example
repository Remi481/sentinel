# Copy this file to .env and replace every placeholder.
# scripts/generate-secrets.sh fills the secret values for you.

# The DNS name this server answers on. Caddy gets a TLS certificate for it
# automatically. Use http://localhost to try the stack locally without TLS.
SENTINEL_DOMAIN=sentinel.example.com

# Database password for the bundled PostgreSQL container.
SENTINEL_DB_PASSWORD=change-me

# Dashboard JWT signing key. At least 32 bytes.
SENTINEL_JWT_SECRET=change-me

# Shared key a new agent presents once to enrol. At least 24 characters.
SENTINEL_ENROLLMENT_KEY=change-me

# Bootstrap admin account, created on first start against an empty database.
# The password must be at least 12 characters.
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=change-me

# Seconds between an agent's metrics and heartbeat samples.
SENTINEL_INTERVAL_SECONDS=30
