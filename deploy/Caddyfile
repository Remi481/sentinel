# Caddy serves the built dashboard and reverse-proxies the API.
#
# Set SENTINEL_DOMAIN to a real DNS name (for example sentinel.example.com) that
# points at this server and Caddy obtains a TLS certificate automatically. For a
# local trial with no TLS, set SENTINEL_DOMAIN=http://localhost.
{$SENTINEL_DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
